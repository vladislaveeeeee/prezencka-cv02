<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.upjs.ics.AttenderController">
   <children>
      <ListView fx:id="attendancesListView" onMouseClicked="#attendancesListViewOnMouseClicked" VBox.vgrow="ALWAYS" />
      <HBox alignment="BOTTOM_RIGHT">
         <children>
            <Button fx:id="deactivateButton" mnemonicParsing="false" onAction="#deactivateButtonAction">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
               <graphic>
                  <FontIcon iconColor="#a60000" iconLiteral="fas-trash" iconSize="16" />
               </graphic>
            </Button>
            <Button fx:id="newAttendanceButton" mnemonicParsing="false" onAction="#newAttendanceButtonOnAction" text="Nová prezenčka" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
